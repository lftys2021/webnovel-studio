# server/models.py
from sqlalchemy import Column, Integer, String, DateTime
from sqlalchemy.ext.declarative import declarative_base
import datetime

Base = declarative_base()

class User(Base):
    __tablename__ = "users"

    id = Column(Integer, primary_key=True, index=True)
    username = Column(String, unique=True, index=True, nullable=False) # 아이디
    hashed_password = Column(String, nullable=True)                  # 비밀번호(SSO는 null 가능)
    name = Column(String, nullable=False)                            # 이름
    email = Column(String, unique=True, index=True, nullable=False)    # 이메일
    phone = Column(String, unique=True, nullable=False)              # 연락처
    provider = Column(String, default="local")                       # local, kakao, naver, google
    created_at = Column(DateTime, default=datetime.datetime.utcnow)